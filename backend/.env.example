# Telegram push (optional — leave empty to skip pushing; reports are still saved)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email push (optional SMTP — leave host/from/to empty to skip)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_USE_TLS=true

# Refresh stale market data once when the backend starts. Keep false during
# development with --reload; enable explicitly in a persistent deployment.
ENABLE_STARTUP_REFRESH=false

# Daily scheduler (Australia/Sydney). Keep false during development with --reload.
ENABLE_SCHEDULER=false
SCHEDULE_HOUR=18
SCHEDULE_MINUTE=30

# Protect /api/admin/* and /api/config*. Required before using Settings/admin APIs.
# When set, send it as Authorization: Bearer <token> or X-Admin-Token.
ADMIN_API_TOKEN=

# Announcement fetching
ANNOUNCEMENT_FETCH_COUNT=20
# Public token embedded in asx.com.au's frontend — override here if it rotates
# ASX_ACCESS_TOKEN=83ff96335c2d45a094df02a206a39ff4

# AI announcement analysis
# noop: no enrichment or document fetch.
# rules_fulltext: fetch announcement document/PDF and extract grade/width/depth via rules.
# claude: fetch document/PDF and call Anthropic only when key + allow flag are set.
AI_ANALYZER=noop
AI_ANALYZER_ALLOW_PAID_CALLS=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_MAX_TOKENS=400
